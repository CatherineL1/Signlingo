# ===== 1. Mount & upload =====
from google.colab import files
uploaded = files.upload()   # pick landmarks.csv produced by labeler.html
import pandas as pd, numpy as np
df = pd.read_csv(list(uploaded.keys())[0])
X = df.iloc[:,1:].values.astype('float32')
y = pd.Categorical(df.iloc[:,0]).codes.astype('int32')
classes = pd.Categorical(df.iloc[:,0]).categories
print("Classes:", len(classes), classes)

# ===== 2. Split =====
from sklearn.model_selection import train_test_split
Xtr,Xval,ytr,yval = train_test_split(X,y,test_size=.15,random_state=42,stratify=y)

# ===== 3. Model =====
import tensorflow as tf
model = tf.keras.Sequential([
    tf.keras.layers.Input(63),
    tf.keras.layers.Dense(128,activation='relu'),
    tf.keras.layers.Dense(64,activation='relu'),
    tf.keras.layers.Dense(len(classes),activation='softmax')
])
model.compile(optimizer='adam',loss='sparse_categorical_crossentropy',metrics=['accuracy'])
model.fit(Xtr,ytr,batch_size=32,epochs=60,validation_data=(Xval,yval),verbose=0)
print("Val acc:", model.evaluate(Xval,yval,verbose=0)[1])

# ===== 4. Export TF.js =====
!mkdir model
tf.saved_model.save(model,'saved')
!tensorflowjs_converter --input_format=tf_saved_model --output_format=tfjs_graph_model saved model
!zip -r model.zip model/
